{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "server.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/books", "destination": "/index.html" },
    { "source": "/books/:path*", "destination": "/index.html" },
    { "source": "/favorites", "destination": "/index.html" },
    { "source": "/reading-list", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
