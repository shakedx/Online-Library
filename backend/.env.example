# Локальная PostgreSQL
DATABASE_URL=postgresql://online_library:YOUR_DEV_PASSWORD@localhost:5432/online_library

# Отдельная локальная база для тестов
TEST_DATABASE_URL=postgresql://online_library_test:YOUR_TEST_PASSWORD@localhost:5432/online_library_test

# Локальная папка TXT считается от backend/
BOOK_STORAGE_PATH=storage/books
STORAGE_DRIVER=local
MAX_BOOK_SIZE_BYTES=5242880

# Укажи случайную строку и не добавляй настоящий ключ в Git
SECRET_KEY=
SESSION_COOKIE_SECURE=false

# На Vercel эта переменная создаётся после подключения Blob
# BLOB_READ_WRITE_TOKEN=

